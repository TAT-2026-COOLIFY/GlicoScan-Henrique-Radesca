# ─────────────────────────────────────────────────────────────────
# .env.example — Modelo de configuração
# ─────────────────────────────────────────────────────────────────
# Copie este arquivo para ".env" (sem o .example) e preencha com suas
# chaves reais. O arquivo .env NUNCA deve ser commitado no Git —
# ele já está no .gitignore.

OCR_API_KEY=sua_chave_do_ocr_space_aqui
FS_CLIENT_ID=seu_client_id_fatsecret_aqui
FS_CLIENT_SECRET=seu_client_secret_fatsecret_aqui

# Opcional — só necessário se você configurar a CalorieAPI como fallback extra
CALORIE_API_KEY=

# Opcional em dev local. Recomendado em produção: sem isso, qualquer um
# com a URL pública do backend lê seu histórico de dose/glicemia e pode
# apagar tudo. Defina um valor aleatório aqui e o MESMO valor em
# frontend/.env.example como VITE_APP_TOKEN.
APP_TOKEN=

# Opcional. Sem isso, RIC/tipo de insulina/glicemia alvo/fator de
# sensibilidade ficam sempre editáveis (comportamento antigo). Com uma
# senha aqui, esses campos ficam só leitura até o médico digitar essa
# senha no app (desbloqueia por 15min). É uma senha só, compartilhada
# entre médicos — não é conta por médico.
DOCTOR_PASSWORD=

# Opcional. '*' (padrão, deixe vazio) libera qualquer origem — ok em dev
# local. Em produção, recomendado travar na URL do Vercel, ex:
# ALLOWED_ORIGINS=https://glicoscan.vercel.app
ALLOWED_ORIGINS=
