# Em produção: URL completa do backend já implantado (ver DEPLOY.md)
VITE_API_URL=https://glicoscan-api.onrender.com

# Em desenvolvimento local: deixe vazio ou comente a linha acima —
# o proxy do vite.config.js já cuida de repassar as chamadas pro
# backend Flask local, sem precisar dessa variável.

# Login (Supabase) — painel do projeto → Settings → API Keys.
# A chave "publishable" é pública por design, pode ir no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...
